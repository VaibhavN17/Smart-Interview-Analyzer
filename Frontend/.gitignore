# Frontend-specific .gitignore for Vite + React (Node)

# Node
node_modules/

# Vite
.vite/
/dist/

# Build outputs
build/

# Env
.env
.env.*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local settings
.vscode/

# OS
.DS_Store
Thumbs.db

# Typescript cache
*.tsbuildinfo

# Dependency directories
pnpm-lock.yaml

# Optional: static port cache
.port

