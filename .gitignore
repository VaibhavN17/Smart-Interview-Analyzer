# Project-level gitignore for Smart-Interview-Analyzer

# Node / Frontend
node_modules/
Frontend/node_modules/
Frontend/dist/
Frontend/.env
Frontend/.env.*

# Vite / cache
.vite/
.parcel-cache/
dist/

# Python / Backend
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.pyt
.python-version
env/
venv/
.venv/
Backend/.venv/
Backend/.env
*.egg-info/
pip-wheel-metadata/
build/
dist/

# Docker
.docker/
docker-compose.override.yml

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
Thumbs.db

# Test / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Python caches / tooling
.mypy_cache/
.ruff_cache/
.ruff/
.cache/

# Celery
celerybeat-schedule
celerybeat.pid

# SQLite
*.sqlite3

# Misc
.env
.env.*
*.pem

